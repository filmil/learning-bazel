# Try building a shell library.

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

sh_library(
    name = "lib",
    srcs = ["lib.sh"],
)

sh_binary(
    name = "bin",
    srcs = ["bin.sh"],
    deps = [":lib"],
)

sh_test(
    name = "lib_test",
    srcs = ["lib_test.sh"],
    size = "small",
    deps = [":lib"],
)
